# Paid / Hackathon Resources
OPENAI_API_KEY=
# Model for the ML memo agent (backend/ml/memo_agent.py)
OPENAI_MEMO_MODEL=gpt-6.2-sol
ELEVENLABS_API_KEY=
N8N_WEBHOOK_URL=
FOUNDERHUNT_WRITE_TOKEN=
FOUNDERHUNT_ENRICH_BUDGET_USD=2
FOUNDERHUNT_ALLOWED_ORIGINS=[]

# Optional Free / Community API Keys (code degrades gracefully if empty)
